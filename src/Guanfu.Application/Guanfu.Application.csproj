<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Guanfu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <!-- 审批闸门要用 ExecuteUpdate 做「条件更新」——
         这是唯一能保证「一条审批只被执行一次」的原子手段。
         版本跟着 EfCoreVersion 走，别单开一条版本线。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Guanfu.Domain\Guanfu.Domain.csproj" />
    <ProjectReference Include="..\Guanfu.Documents\Guanfu.Documents.csproj" />
  </ItemGroup>

</Project>
