    // ---- 评审回写 ----

    /// <summary>
    /// 这个维度的结论控件是否展开。
    ///
    /// 没判过的默认展开（正要填），判过的默认收起，点「改结论」才展开。
    /// </summary>
    private bool IsOpenDimension(ReviewItemDto item) =>
        _openDimensions.Contains(item.Dimension)
        || IsUndecided(item);

    /// <summary>这个维度还没给结论。</summary>
    private static bool IsUndecided(ReviewItemDto item) =>
        item.Status is not ("Passed" or "Failed" or "Skipped");

    private void OpenDimension(ReviewItemDto item)
    {
        _openDimensions.Add(item.Dimension);

        // 已填过的理由带回来，省得重写一遍
        if (!_reviewFindings.ContainsKey(item.Dimension) && !string.IsNullOrWhiteSpace(item.Findings))
        {
            _reviewFindings[item.Dimension] = item.Findings;
        }
    }

    private string GetReviewFindings(string dimension) =>
        _reviewFindings.TryGetValue(dimension, out var findings) ? findings : string.Empty;

    private void SetReviewFindings(string dimension, string? value) => _reviewFindings[dimension] = value ?? string.Empty;

    private async Task SubmitDimensionAsync(string dimension, bool passed, bool skipped)
    {
        if (Busy)
        {
            return;
        }

        var findings = GetReviewFindings(dimension);
        if (skipped && string.IsNullOrWhiteSpace(findings))
        {
            Error = PageError.Simple("跳过必须写理由 —— 「本次改动不涉及该维度」要说清楚为什么。");
            return;
        }

        Busy = true;
        StateHasChanged();

        try
        {
            await Reviews.SubmitAsync(
                TaskId, dimension, passed,
                string.IsNullOrWhiteSpace(findings) ? null : findings,
                reviewer: "human", skipped: skipped);
            _reviewFindings.Remove(dimension);
            // 判完就收起来 —— 下一轮再点「改结论」才展开
            _openDimensions.Remove(dimension);
            Error = null;
            await RefreshReviewsAndEventsAsync();
        }
        catch (Exception ex)
        {
            Error = PageError.From(ex, "回写评审维度");
        }
        finally
        {
            Busy = false;
        }
    }

