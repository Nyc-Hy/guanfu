    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        // 连点两次：第二个事件到达时第一个可能还没跑完 ——
        // 那就会把同一个文件存两遍
        if (Uploading)
        {
            return;
        }

        IReadOnlyList<IBrowserFile> files;
        try
        {
            files = args.GetMultipleFiles(MaxUploadFiles).ToList();
        }
        catch (InvalidOperationException)
        {
            Error = PageError.Simple($"一次最多传 {MaxUploadFiles} 个文件，请分批传。");
            return;
        }

        var pending = new List<IBrowserFile>();
        var duplicated = new List<string>();

        foreach (var file in files)
        {
            var key = UploadKey(file);

            // 同一个文件不重复传：Blazor 的事件排队处理，
            // 「正在上传」标志在第二个事件被处理时早就复位了
            if (_uploads.IsLatched(key))
            {
                duplicated.Add(file.Name);
                continue;
            }

            _uploads.TryLatch(key);
            pending.Add(file);
        }

        if (pending.Count == 0)
        {
            Error = PageError.Simple(duplicated.Count > 0
                ? $"《{duplicated[0]}》已经传过了。"
                : "没有选到文件。");
            return;
        }

        Uploading = true;
        UploadFailures = [];
        StateHasChanged();

        var failed = new List<UploadFailure>();
        var uploaded = 0;

        // 一个一个传：传砸的那个不影响后面的
        foreach (var file in pending)
        {
            try
            {
                await using var stream = file.OpenReadStream(MaxUploadBytes);
                await Documents.UploadAsync(TaskId, file.Name, stream);
                uploaded++;
            }
            catch (Exception ex)
            {
                // 失败就放掉，好让人重传
                _uploads.Release(UploadKey(file));
                failed.Add(new UploadFailure(file.Name, PageError.From(ex, "上传文档").Message));
            }
        }

        Uploading = false;
        UploadFailures = failed;
        Error = failed.Count == 0
            ? null
            : PageError.Simple($"{uploaded} 个传上去，{failed.Count} 个没传上去。");

        await RefreshContextAndEventsAsync();
    }

    private sealed record UploadFailure(string FileName, string Error);

    private static string UploadKey(IBrowserFile file) => $"{file.Name}:{file.Size}";

    // ---- 事件时间线的展示 ----

    private static string Relative(DateTimeOffset time)
    {
        var delta = DateTimeOffset.UtcNow - time;
        if (delta.TotalSeconds < 60) return "刚刚";
        if (delta.TotalHours < 1) return $"{(int)delta.TotalMinutes} 分钟前";
        if (delta.TotalDays < 1) return $"{(int)delta.TotalHours} 小时前";
        return $"{(int)delta.TotalDays} 天前";
    }

    private static string EventLabel(string? eventType) => eventType switch
    {
        TaskEventTypes.StatusChanged => "状态迁移",
        TaskEventTypes.PlanSaved => "计划",
        TaskEventTypes.ArtifactAdded => "产物",
        TaskEventTypes.TestReported => "测试",
        TaskEventTypes.DependencyAdded => "加依赖",
        TaskEventTypes.DependencyRemoved => "删依赖",
        TaskEventTypes.Assigned => "分派",
        TaskEventTypes.Archived => "归档",
        TaskEventTypes.Note => "备注",
        TaskEventTypes.Claimed => "领取",
        TaskEventTypes.Released => "释放",
        TaskEventTypes.ReviewRoundOpened => "评审开轮",
        TaskEventTypes.ReviewDimensionResult => "维度结论",
        TaskEventTypes.ReviewRoundClosed => "评审结轮",
        TaskEventTypes.AgentLaunched => "agent 启动",
        TaskEventTypes.AgentExited => "agent 退出",
        TaskEventTypes.MilestoneAssigned => "迭代",
        TaskEventTypes.TypeChanged => "类型",
        TaskEventTypes.BranchBound => "分支",
        _ => eventType ?? "事件"
    };

    private static string EventIcon(string? eventType) => eventType switch
    {
        TaskEventTypes.StatusChanged => "⇄",
        TaskEventTypes.PlanSaved => "≡",
        TaskEventTypes.ArtifactAdded => "◆",
        TaskEventTypes.TestReported => "✓",
        TaskEventTypes.DependencyAdded or TaskEventTypes.DependencyRemoved => "↔",
        TaskEventTypes.Assigned => "◎",
        TaskEventTypes.Archived => "▣",
        TaskEventTypes.Claimed or TaskEventTypes.Released => "●",
        TaskEventTypes.ReviewRoundOpened => "◇",
        TaskEventTypes.ReviewDimensionResult => "◈",
        TaskEventTypes.ReviewRoundClosed => "◆",
        TaskEventTypes.AgentLaunched => "▶",
        TaskEventTypes.AgentExited => "■",
        TaskEventTypes.MilestoneAssigned => "▤",
        TaskEventTypes.TypeChanged => "✎",
        TaskEventTypes.BranchBound => "⎇",
        _ => "·"
    };

    /// <summary>
    /// 事件类型的展示色（CSS 类）。
    ///
    /// 颜色本身在 CSS 里 —— 早先这里直接返回 #2563eb 这样的硬编码值内联进 style，
    /// 亮色主题下那些颜色在浅底上对比度不够，而且颜色散在页面里，
    /// 换主题时根本不知道还有这些地方要改。
    /// </summary>
    private static string EventColorClass(string? eventType) => eventType switch
    {
        TaskEventTypes.StatusChanged => "wb-ev-blue",
        TaskEventTypes.PlanSaved => "wb-ev-purple",
        TaskEventTypes.ArtifactAdded => "wb-ev-cyan",
        TaskEventTypes.TestReported => "wb-ev-green",
        TaskEventTypes.Assigned or TaskEventTypes.MilestoneAssigned or TaskEventTypes.TypeChanged => "wb-ev-amber",
        TaskEventTypes.ReviewRoundOpened or TaskEventTypes.ReviewDimensionResult or TaskEventTypes.ReviewRoundClosed => "wb-ev-purple",
        TaskEventTypes.AgentLaunched => "wb-ev-green",
        TaskEventTypes.BranchBound or TaskEventTypes.Claimed or TaskEventTypes.Released => "wb-ev-cyan",
        _ => "wb-ev-gray"
    };

    public async ValueTask DisposeAsync()
    {
        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }
}
