    private async Task SaveAssignmentAsync()
    {
        if (Busy)
        {
            return;
        }

        if (!Enum.TryParse<TaskPriority>(PriorityInput, ignoreCase: true, out var priority))
        {
            Error = PageError.Simple($"未知优先级: {PriorityInput}");
            return;
        }

        DateTimeOffset? dueAt = null;
        if (!string.IsNullOrWhiteSpace(DueInput))
        {
            if (!DateTimeOffset.TryParse(DueInput, out var parsedDue))
            {
                Error = PageError.Simple($"截止日格式不对: {DueInput}");
                return;
            }

            dueAt = parsedDue;
        }

        Busy = true;
        StateHasChanged();

        try
        {
            await Tasks.SetAssignmentAsync(
                TaskId,
                string.IsNullOrWhiteSpace(AssigneeInput) ? null : AssigneeInput.Trim(),
                priority, dueAt);
            Error = null;
            await RefreshContextAndEventsAsync();
        }
        catch (Exception ex)
        {
            Error = PageError.From(ex, "保存分派");
        }
        finally
        {
            Busy = false;
        }
    }

