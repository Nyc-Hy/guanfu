@page "/login"
@layout Guanfu.Web.Components.Layout.LoginLayout

<PageTitle>登录 · 观复</PageTitle>

<div class="wb-page-head">
    <h1>登录观复</h1>
</div>

<form id="wb-login" class="wb-panel" method="post" data-return-url="@ReturnUrl">
    <div class="wb-field-row">
        <label class="wb-label" for="login-user">用户名</label>
        <input id="login-user" name="userName" autocomplete="username" required />
    </div>

    <div class="wb-field-row">
        <label class="wb-label" for="login-pass">密码</label>
        <input id="login-pass" name="password" type="password" autocomplete="current-password" required />
    </div>

    <p class="wb-error" role="alert" hidden></p>

    <div class="wb-form-row wb-mt-3">
        <button type="submit" class="wb-btn wb-btn-primary">登录</button>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }
}
