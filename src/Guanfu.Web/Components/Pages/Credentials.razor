@page "/credentials"
@rendermode InteractiveServer
@inject ICredentialService CredentialStore
@inject IMemberService MemberStore
@inject IProjectService Projects
@inject HumanTokenAccessor Tokens
@inject IJSRuntime JS

<PageTitle>访问凭证 · 观复</PageTitle>

<div class="wb-page-head">
    <div>
        <h1>访问凭证</h1>
        <p class="wb-muted">
            一台服务器给一个团队用时，「谁在操作」必须是真的。
            凭证在<strong>签发</strong>的时候就把身份绑上：绑谁、能看哪些项目。
            运行时带的只是那把钥匙 —— 明文只显示这一次，之后谁都看不到了。
        </p>
    </div>
</div>

<div class="wb-detail-grid">
    <div class="wb-detail-main">
        <PageTokenGate @bind-Authorized="Authorized" />

        @if (!Authorized)
        {
            <section class="wb-panel">
                <h3>要先有人在旁边</h3>
                <p class="wb-muted">
                    「给人发钥匙」跟裁决审批是同权的事 —— 拿到钥匙的人能顶替身份操作。
                    所以签发凭证要人工凭证：上面验证通过才能签发。
                </p>
            </section>
        }
        else
        {
            @if (IssuedToken is not null)
            {
                <section class="wb-panel">
                    <div class="wb-card-head">
                        <h3>新凭证（只显示这一次）</h3>
                        <span class="wb-chip wb-chip-ok">复制走</span>
                    </div>
                    <p class="wb-muted">
                        关掉这个页面就再也看不到了 —— 库里只存哈希。
                        丢了就吊销这把，再签一把新的。
                    </p>
                    <pre class="wb-doc-code">@IssuedToken</pre>
                    <div class="wb-form-row">
                        <button class="wb-btn" @onclick="() => CopyAsync(IssuedToken)">复制</button>
                    </div>
                </section>
            }

            <section class="wb-panel">
                <div class="wb-card-head">
                    <h3>签发一把</h3>
                </div>

                <div class="wb-form-row">
                    <label class="wb-label">给谁</label>
                    <select class="wb-input" @bind="Kind">
                        <option value="Agent">agent（走 MCP 干活）</option>
                        <option value="Member">成员（人：裁决审批、改配置）</option>
                    </select>
                </div>

                <div class="wb-field-row">
                    <label class="wb-label">身份</label>
                    <input class="wb-input" placeholder="agent id 或成员名，例如 agent-a / 张三"
                           @bind="Subject" @bind:event="oninput" />
                </div>

                <div class="wb-form-row">
                    <label class="wb-label">能看到哪些项目</label>
                    <select class="wb-input" @bind="ProjectScopeValue">
                        <option value="">全部项目</option>
                        @foreach (var project in ProjectItems)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </select>
                </div>

                <div class="wb-field-row">
                    <label class="wb-label">归属成员</label>
                    <select class="wb-input" @bind="MemberIdValue">
                        <option value="">不指定（不跟人绑）</option>
                        @foreach (var member in MemberItems)
                        {
                            <option value="@member.Id">@member.DisplayName（@member.UserName）</option>
                        }
                    </select>
                </div>

                <div class="wb-field-row">
                    <label class="wb-label">备注</label>
                    <input class="wb-input" placeholder="给谁的、为什么发（自己看得懂就行）"
                           @bind="Note" @bind:event="oninput" />
                </div>

                <ErrorNotice Error="@Error" />

                <div class="wb-form-row">
                    <button class="wb-btn wb-btn-primary" disabled="@(Busy || string.IsNullOrWhiteSpace(Subject))"
                            @onclick="IssueAsync">签发</button>
                    <span class="wb-muted">
                        @if (Kind == CredentialKind.Agent)
                        {
                            <text>agent 凭证：agent 的身份以它为准，不能靠请求头自称。</text>
                        }
                        else
                        {
                            <text>成员凭证：能裁决审批、改项目配置。</text>
                        }
                    </span>
                </div>
            </section>

            <section class="wb-panel">
                <div class="wb-card-head">
                    <h3>已签发的凭证</h3>
                    <span class="wb-muted">@Items.Count 把</span>
                </div>
                @if (Items.Count == 0)
                {
                    <p class="wb-muted">还没有签发过凭证。</p>
                }
                else
                {
                    <div class="wb-table-scroll">
                        <table class="wb-table">
                            <thead>
                            <tr>
                                <th>身份</th>
                                <th>种类</th>
                                <th>归属成员</th>
                                <th>能看到</th>
                                <th>指纹</th>
                                <th>签发</th>
                                <th>状态</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Items)
                            {
                                <tr>
                                    <td>
                                        @item.Subject
                                        @if (!string.IsNullOrWhiteSpace(item.Note))
                                        {
                                            <div class="wb-muted">@item.Note</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="wb-chip">@(item.Kind == "Agent" ? "agent" : "成员")</span>
                                    </td>
                                    <td class="wb-muted">
                                        @(string.IsNullOrWhiteSpace(item.MemberName) ? "—" : item.MemberName)
                                    </td>
                                    <td class="wb-muted">
                                        @(item.ProjectScope.Count == 0 ? "全部项目" : $"{item.ProjectScope.Count} 个项目")
                                    </td>
                                    <td class="wb-muted"><code>@item.Fingerprint</code></td>
                                    <td class="wb-muted">@item.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</td>
                                    <td>
                                        @if (item.RevokedAt is not null)
                                        {
                                            <span class="wb-chip wb-chip-danger">已吊销</span>
                                        }
                                        else if (item.ExpiresAt is DateTimeOffset expires && expires <= DateTimeOffset.UtcNow)
                                        {
                                            <span class="wb-chip wb-chip-warn">已过期</span>
                                        }
                                        else
                                        {
                                            <span class="wb-chip wb-chip-ok">有效</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.RevokedAt is null)
                                        {
                                            <button class="wb-btn wb-btn-link" disabled="@Busy"
                                                    @onclick="() => RevokeAsync(item.Id)">吊销</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>

    <aside class="wb-detail-side">
        <section class="wb-panel">
            <h3>团队部署时怎么用</h3>
            <p class="wb-muted">
                <strong>agent 凭证</strong>：给每个 agent 一把，它只能看见你指定的项目。
                MCP 客户端在请求头 <code>X-Guanfu-Token</code>（或 <code>Authorization: Bearer</code>）里带上。
            </p>
            <p class="wb-muted">
                <strong>成员凭证</strong>：给人 —— 裁决审批、改项目配置这些「有人在旁边」的动作。
            </p>
            <p class="wb-muted">
                <strong>共享人工凭证</strong>（数据目录里那个 token）= owner，全权，
                只给部署的人。它也能开 /mcp —— 本机单人用时就是这么干的。
            </p>
        </section>
    </aside>
</div>

@code {
    private bool Authorized { get; set; }

    private IReadOnlyList<CredentialDto> Items { get; set; } = [];
    private IReadOnlyList<ProjectSummaryDto> ProjectItems { get; set; } = [];
    private IReadOnlyList<MemberDto> MemberItems { get; set; } = [];

    /// <summary>这把钥匙归属谁（空 = 不跟人绑）。</summary>
    private string MemberIdValue { get; set; } = string.Empty;

    private CredentialKind Kind { get; set; } = CredentialKind.Agent;
    private string Subject { get; set; } = string.Empty;
    private string Note { get; set; } = string.Empty;
    private string ProjectScopeValue { get; set; } = string.Empty;

    private string? IssuedToken { get; set; }
    private bool Busy { get; set; }
    private PageError? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            Items = await CredentialStore.ListAsync();
            ProjectItems = await Projects.ListAsync();
            MemberItems = await MemberStore.ListAsync();
        }
        catch (Exception ex)
        {
            Error = PageError.From(ex, "读取凭证");
        }
    }

    private async Task IssueAsync()
    {
        if (Busy || string.IsNullOrWhiteSpace(Subject))
        {
            return;
        }

        Busy = true;
        Error = null;
        StateHasChanged();

        try
        {
            var scope = string.IsNullOrWhiteSpace(ProjectScopeValue)
                ? null
                : new List<Guid> { Guid.Parse(ProjectScopeValue) };

            var issued = await CredentialStore.IssueAsync(
                Kind,
                Subject,
                scope,
                Note,
                createdBy: "owner",
                memberId: string.IsNullOrWhiteSpace(MemberIdValue)
                    ? null
                    : Guid.Parse(MemberIdValue));

            IssuedToken = issued.Token;
            Subject = string.Empty;
            Note = string.Empty;
            MemberIdValue = string.Empty;

            await LoadAsync();
        }
        catch (Exception ex)
        {
            Error = PageError.From(ex, "签发凭证");
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task RevokeAsync(Guid id)
    {
        if (Busy)
        {
            return;
        }

        Busy = true;
        Error = null;
        StateHasChanged();

        try
        {
            await CredentialStore.RevokeAsync(id);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Error = PageError.From(ex, "吊销凭证");
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception)
        {
            // 浏览器不给剪贴板权限就算了，内容在页面上可以手动选
        }
    }
}
