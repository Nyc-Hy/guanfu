@page "/mcp-tools"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Http
@inject IMcpToolService Tools
@inject HumanTokenAccessor Tokens
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>MCP 工具 · 观复</PageTitle>

<div class="wb-page-head">
    <div>
        <h1>MCP 工具</h1>
        <p class="wb-muted">
            关掉的工具不会出现在 <code>tools/list</code> 里，agent 看不到也就不会去调；
            就算客户端缓存了清单硬调，也会被服务端拒绝。
        </p>
    </div>
    <div class="wb-form-row">
        <span class="wb-chip">@EnabledCount / @Items.Count 开启</span>
        <button class="wb-btn" disabled="@(Saving || !Gate.Authorized)" @onclick="ResetAsync">全部恢复默认</button>
    </div>
</div>

<ErrorNotice Error="ActionError" />
<ErrorNotice Error="LoadError" />

@if (!Gate.Authorized)
{
    <div class="wb-panel">
        <p class="wb-error">开关 MCP 工具需要人工凭证 —— 这改的是 agent 的能力面。</p>
        <p class="wb-muted">
            在本机打开观复时会自动获取；远程访问请从启动观复的控制台复制人工 token，粘贴到下面。
        </p>
        <div class="wb-form-row">
            <input class="wb-input" type="password" placeholder="人工 token（控制台里那串）"
                   @oninput="OnTokenInputChanged" />
            <button class="wb-btn wb-btn-primary"
                    disabled="@string.IsNullOrWhiteSpace(TokenInput)"
                    @onclick="VerifyToken">验证</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Gate.Hint))
        {
            <p class="wb-hint">@Gate.Hint</p>
        }
    </div>
}

@if (Loading)
{
    <div class="wb-empty">加载中…</div>
}
else if (Items.Count == 0)
{
    <div class="wb-empty">@(LoadError is null ? "没有发现任何 MCP 工具。" : "工具清单加载失败。")</div>
}
else
{
    @* 62 个工具分 4 组全铺开是 5000 多像素的一长条 —— 按组分页签，
       组内再分页 + 能搜。一次只看得到当前这一组。 *@
    <div class="wb-tabs" role="tablist">
        @foreach (var group in Groups)
        {
            <button class="wb-tab @(ActiveGroup == group.Key ? "wb-tab-active" : "")" role="tab"
                    aria-selected="@(ActiveGroup == group.Key)" @onclick="() => GoGroup(group.Key)">
                @group.Key <span class="wb-count">@group.Count()</span>
            </button>
        }
    </div>

    <div class="wb-filter-bar">
        <input class="wb-input" type="search" placeholder="搜工具名或说明"
               value="@Search" @oninput="OnSearchChanged" />
        <span class="wb-muted">
            @if (string.IsNullOrWhiteSpace(Search))
            {
                <text>本组 @CurrentTools.Count 个工具</text>
            }
            else
            {
                <text>匹配 @CurrentTools.Count 个</text>
            }
        </span>
    </div>

    @if (CurrentTools.Count == 0)
    {
        <div class="wb-empty">
            @if (string.IsNullOrWhiteSpace(Search))
            {
                <text>这一组没有工具。</text>
            }
            else
            {
                <text>没找到匹配「@Search」的工具。</text>
            }
        </div>
    }
    else
    {
        <section class="wb-panel">
            <div class="wb-table-scroll">
                <table class="wb-table">
                    <thead>
                    <tr>
                        <th class="wb-col-switch">开关</th>
                        <th class="wb-col-tool">工具</th>
                        <th>说明</th>
                        <th class="wb-col-policy">策略</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var tool in PagedTools)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" checked="@tool.Enabled" disabled="@(Saving || !Gate.Authorized)"
                                       @onchange="e => SetEnabledAsync(tool.Name, (bool)(e.Value ?? false))" />
                            </td>
                            <td>
                                <div class="wb-tool-line">@UiText.Tool(tool.Name)</div>
                                <div class="wb-muted wb-tool-code"><code>@tool.Name</code></div>
                            </td>
                            <td class="wb-muted wb-tool-desc">@tool.Description</td>
                            <td>
                                @if (tool.RequiresApproval)
                                {
                                    <span class="wb-tag wb-tag-warn">需人工审批</span>
                                }
                                else
                                {
                                    <span class="wb-tag wb-tag-ok">直接执行</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (PageCount > 1)
            {
                <div class="wb-pager">
                    <button class="wb-btn" disabled="@(PageIndex == 0)" @onclick="PrevPage">上一页</button>
                    <span class="wb-muted">第 @(PageIndex + 1) / @PageCount 页</span>
                    <button class="wb-btn" disabled="@(PageIndex >= PageCount - 1)" @onclick="NextPage">下一页</button>
                </div>
            }
        </section>
    }
}

@code {
    private const int PageSize = 20;

    private IReadOnlyList<McpToolInfo> Items { get; set; } = [];
    private bool Saving { get; set; }
    private bool Loading { get; set; }
    private PageError? ActionError { get; set; }
    private PageError? LoadError { get; set; }

    // ---- 人工凭证（开关工具 = 改 agent 能力面，必须有人在场）----
    private UiTokenGate Gate { get; set; } = default!;
    private string TokenInput { get; set; } = string.Empty;

    [CascadingParameter] public HttpContext? RequestContext { get; set; }

    /// <summary>
    /// 分组页签跟着 URL 走 ——「/mcp-tools?cat=docs」能直接落到文档组，
    /// 链接也能发给人。默认「观复组」。
    /// </summary>
    [SupplyParameterFromQuery(Name = "cat")]
    public string? Cat { get; set; }

    private string Search { get; set; } = string.Empty;
    private int PageIndex { get; set; }

    private int EnabledCount => Items.Count(t => t.Enabled);

    /// <summary>按目录里的分类顺序分组，组内保持目录顺序。</summary>
    private IEnumerable<IGrouping<string, McpToolInfo>> Groups =>
        Items.GroupBy(t => t.Category);

    /// <summary>当前分组。URL 没给（cat 缺失或认不出来）就落在第一组。</summary>
    private string ActiveGroup
    {
        get
        {
            var groups = Groups.ToList();
            if (groups.Count == 0)
            {
                return string.Empty;
            }

            if (!string.IsNullOrWhiteSpace(Cat))
            {
                var wanted = UiText.ToolGroupOf(Cat);
                var hit = groups.FirstOrDefault(g => g.Key == wanted);
                if (hit is not null)
                {
                    return hit.Key;
                }
            }

            return groups[0].Key;
        }
    }

    /// <summary>当前分组里、命中搜索词的工具。</summary>
    private List<McpToolInfo> CurrentTools
    {
        get
        {
            var list = Items.Where(t => t.Category == ActiveGroup).ToList();

            if (string.IsNullOrWhiteSpace(Search))
            {
                return list;
            }

            var q = Search.Trim();
            return list
                .Where(t => t.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                            || t.Description.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private int PageCount => Math.Max(1, (CurrentTools.Count + PageSize - 1) / PageSize);

    private IEnumerable<McpToolInfo> PagedTools =>
        CurrentTools.Skip(PageIndex * PageSize).Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        Gate = new UiTokenGate(Tokens.Token);
        Gate.AuthorizeFromRequest(RequestContext?.Request);
        await ReloadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = AcquireTokenAsync();
        }

        return Task.CompletedTask;
    }

    private async Task AcquireTokenAsync()
    {
        if (Gate.Authorized)
        {
            return;
        }

        string? payload = null;

        try
        {
            payload = await JS.InvokeAsync<string>("eval", ApprovalUiGuard.FetchTokenScript);
        }
        catch (JSException)
        {
            // 取不到就走粘贴流程
        }
        catch (InvalidOperationException)
        {
            // 预渲染阶段没有 JS 运行时
        }

        Gate.ApplyFetchResult(payload);
        StateHasChanged();
    }

    private void OnTokenInputChanged(ChangeEventArgs args) =>
        TokenInput = args.Value?.ToString() ?? string.Empty;

    private void VerifyToken()
    {
        if (Gate.TryVerify(TokenInput))
        {
            TokenInput = string.Empty;
            ActionError = null;
        }
    }

    /// <summary>切分组。URL 是唯一真相 —— 深链能直接落到某一组。</summary>
    private void GoGroup(string group)
    {
        if (group == ActiveGroup)
        {
            return;
        }

        PageIndex = 0;
        Search = string.Empty;
        Nav.NavigateTo($"/mcp-tools?cat={UiText.ToolGroupSlug(group)}", replace: true);
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        Search = args.Value?.ToString() ?? string.Empty;
        PageIndex = 0;
    }

    private void PrevPage() => PageIndex = Math.Max(0, PageIndex - 1);

    private void NextPage() => PageIndex = Math.Min(PageCount - 1, PageIndex + 1);

    private async Task ReloadAsync()
    {
        Loading = true;

        try
        {
            Items = await Tools.ListAsync();
            LoadError = null;
        }
        catch (Exception ex)
        {
            // 别让异常从初始化方法冒出去 —— 冒出去就是整页白屏
            LoadError = PageError.From(ex, "加载工具清单");
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task SetEnabledAsync(string toolName, bool enabled)
    {
        // 连点两次：第二个事件到达时第一个可能还没跑完
        if (Saving)
        {
            return;
        }

        if (!Gate.Authorized)
        {
            ActionError = PageError.Simple(ApprovalUiGuard.MissingTokenMessage);
            await ReloadAsync();
            return;
        }

        Saving = true;

        // 立刻把控件置灰：Blazor 在 await 期间不重绘
        StateHasChanged();

        try
        {
            await Tools.SetEnabledAsync(toolName, enabled);
            ActionError = PageError.Notice(enabled
                ? $"已开启 {toolName}。"
                : $"已关闭 {toolName}。agent 不会再看到它。");
        }
        catch (Exception ex)
        {
            ActionError = PageError.From(ex, $"开关工具 {toolName}");
        }
        finally
        {
            Saving = false;
        }

        await ReloadAsync();
    }

    private async Task ResetAsync()
    {
        if (Saving)
        {
            return;
        }

        if (!Gate.Authorized)
        {
            ActionError = PageError.Simple(ApprovalUiGuard.MissingTokenMessage);
            return;
        }

        Saving = true;
        StateHasChanged();

        try
        {
            Items = await Tools.ResetAsync();
            ActionError = PageError.Notice("已恢复默认（全部工具开启）。");
        }
        catch (Exception ex)
        {
            ActionError = PageError.From(ex, "恢复默认工具开关");
        }
        finally
        {
            Saving = false;
        }
    }
}
