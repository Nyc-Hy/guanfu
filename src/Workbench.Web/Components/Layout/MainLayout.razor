@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory

<div class="wb-shell">
    <header class="wb-topbar">
        <a class="wb-brand" href="/">开发工作台</a>
        <nav class="wb-nav">
            <a href="/">总览</a>
            <a href="/metrics">度量</a>
            <a href="/db-calls">数据库调用</a>
            <a href="/audit">审计</a>
            <a href="/approvals">审批 @if (PendingCount > 0)
            {
                <span class="wb-badge">@PendingCount</span>
            }</a>
            <span class="wb-nav-sep"></span>
            <a href="/db-connections">连接</a>
            <a href="/mcp-tools">MCP 工具</a>
            <span class="wb-nav-sep"></span>
            <a href="/connect">接入 agent</a>
            <a href="/workspace">工作区</a>
            <a href="/search">搜索</a>
        </nav>
    </header>

    <main class="wb-main">
        <ErrorNotice Error="LoadError" />
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    页面出错了，刷新一下试试。
    <a href="" class="reload">重新加载</a>
    <a class="dismiss">关闭</a>
</div>

@code {
    // 待审徽章自己会刷：审批多半是 agent 发起的，只在 OnInitializedAsync 读一次
    // 的话，徽章永远停在上一次打开页面时的数字。
    private static readonly TimeSpan BadgeRefreshInterval = TimeSpan.FromSeconds(30);

    private int PendingCount { get; set; }
    private PageError? LoadError { get; set; }
    private CancellationTokenSource? _timerCts;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // 只在交互阶段起定时器：预渲染出来的实例用完就扔，
        // 在那儿起定时器等于漏一个永远在跑的后台任务。
        if (firstRender)
        {
            _timerCts = new CancellationTokenSource();
            _ = RunBadgeTimerAsync(_timerCts.Token);
        }

        return Task.CompletedTask;
    }

    private async Task RunBadgeTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(BadgeRefreshInterval);

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // 组件被销毁，正常收尾
        }
        catch (ObjectDisposedException)
        {
            // 电路已经断了
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            // 每次刷新独立 scope：布局的定时器与页面共用电路级 DbContext 的话，
            // 页面正在查库时徽章也来查，就是 "A second operation was started"。
            using var scope = ScopeFactory.CreateScope();
            var approvals = scope.ServiceProvider.GetRequiredService<IApprovalService>();
            var pending = await approvals.ListAsync(ApprovalStatus.Pending);
            PendingCount = pending.Count;
            LoadError = null;
        }
        catch (Exception ex)
        {
            // 布局包住每一个页面：这里抛出去就是整页白屏
            LoadError = PageError.From(ex, "加载待审数量");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }
}
