@page "/"
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject IMetricsService MetricsService
@inject NavigationManager Nav
@implements IAsyncDisposable

<PageTitle>总览 · 开发工作台</PageTitle>

<div class="wb-page-head">
    <div>
        <h1>总览</h1>
        <p class="wb-muted">
            工作台做三件事：<strong>追踪任务进度</strong>、<strong>记录开发产出的文件</strong>、
            <strong>留下数据库调用的记录</strong>。「现在」是此刻的局面，「项目」是每个项目的体检。
        </p>
    </div>
    <div class="wb-form-row">
        <span class="wb-muted">每 15 秒自动刷新</span>
        <button class="wb-btn" disabled="@Loading" @onclick="() => ReloadAsync()">刷新</button>
    </div>
</div>

<ErrorNotice Error="@LoadError" />

@if (Loading && Data is null)
{
    <div class="wb-empty">加载中…</div>
}
else
{
    <div class="wb-tabs">
        <button class="wb-tab @(ActiveTab == "now" ? "wb-tab-active" : "")" @onclick="GoNow">
            现在
        </button>
        <button class="wb-tab @(ActiveTab == "projects" ? "wb-tab-active" : "")" @onclick="GoProjects">
            项目
        </button>
    </div>

    @if (ActiveTab == "now")
    {
        @if (Data is null || Data.Projects.Count == 0)
        {
            @* 一个项目都没有的时候，三块空面板全是噪声 —— 直接给上手路标 *@
            <div class="wb-panel wb-onboard">
                <h3>三步开始用</h3>
                <ol class="wb-doc-list">
                    <li>
                        <strong>建个项目，绑上你的本地仓库</strong><br />
                        切到「项目」页签新建，填名字和仓库路径（绝对路径，如
                        <code>/Users/you/code/your-repo</code>）。绑了之后，
                        agent 在这个目录里干活就会自动落到本项目 —— 不用再自己传项目 ID。
                    </li>
                    <li>
                        <strong>把 agent 接进来</strong><br />
                        <a href="/connect">接入 agent</a> 页上有现成的配置，复制到 Claude Code / Codex 里就能用。
                    </li>
                    <li>
                        <strong>agent 领任务干活，要写操作时来审批</strong><br />
                        agent 自己领任务、回写计划、改代码；改数据库、提交代码、推送、执行命令这几类
                        要你点头，审批会出现在 <a href="/approvals">审批</a> 页。
                    </li>
                </ol>
            </div>
        }
        else
        {
            <!-- ① 要你处理的 -->
            <div class="wb-panel">
                <h3>要你处理的</h3>
                @if (Data!.PendingApprovals.Count == 0)
                {
                    <p class="wb-muted">没有等你批的写操作。</p>
                }
                else
                {
                    <p class="wb-muted">这些写操作在等人点头 —— 批了才能执行。</p>
                    <div class="wb-table-scroll">
                        <table class="wb-table">
                            <thead>
                            <tr><th>要做什么</th><th>在哪个项目</th><th>等多久了</th><th></th></tr>
                            </thead>
                            <tbody>
                            @foreach (var a in Data.PendingApprovals)
                            {
                                <tr>
                                    <td>@a.Summary</td>
                                    <td class="wb-muted">@(a.ProjectName ?? "—")</td>
                                    <td class="wb-muted" title="@Absolute(a.CreatedAt)">@Relative(a.CreatedAt)</td>
                                    <td><a class="wb-btn wb-btn-link" href="/approvals?id=@a.Id">去处理</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- ② 正在发生的 -->
            <div class="wb-panel">
                <h3>正在发生的</h3>
                @if (Data.ActiveTasks.Count == 0 && Data.ActiveSessions.Count == 0)
                {
                    <p class="wb-muted">当前没有进行中的任务，也没有 agent 在干活。</p>
                }
                else
                {
                    @if (Data.ActiveSessions.Count > 0)
                    {
                        <p class="wb-muted">
                            @foreach (var s in Data.ActiveSessions)
                            {
                                <span class="wb-chip wb-chip-agent">@s.AgentId</span>
                                <span class="wb-muted">在 @s.ProjectName@(string.IsNullOrWhiteSpace(s.TaskKey) ? "" : $" · {s.TaskKey}") · </span>
                            }
                        </p>
                    }

                    @if (Data.ActiveTasks.Count > 0)
                    {
                        <div class="wb-table-scroll">
                            <table class="wb-table">
                                <thead>
                                <tr><th>任务</th><th>项目</th><th>状态</th><th>在谁手上</th><th>最后动静</th></tr>
                                </thead>
                                <tbody>
                                @foreach (var t in Data.ActiveTasks)
                                {
                                    <tr>
                                        <td><a href="/tasks/@t.Id">@UiText.TaskRef(t.Key, t.Title)</a></td>
                                        <td class="wb-muted">@t.ProjectName</td>
                                        <td><span class="wb-chip @UiText.StatusClass(t.Status)">@UiText.Status(t.Status)</span></td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(t.AgentId))
                                            {
                                                <span class="wb-chip wb-chip-agent">@t.AgentId</span>
                                            }
                                            else
                                            {
                                                <span class="wb-muted">还没人领</span>
                                            }
                                        </td>
                                        <td class="wb-muted" title="@(t.LastActivityAt is null ? "" : Absolute(t.LastActivityAt.Value))">@(t.LastActivityAt is null ? "—" : Relative(t.LastActivityAt.Value))</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>

            <!-- ③ 最近产出 -->
            <div class="wb-panel">
                <div class="wb-card-head">
                    <h3>最近产出</h3>
                    <span class="wb-muted">代码改动是工作台自己从 git 数出来的，不是 agent 自报的</span>
                </div>
                @if (Activity.Count == 0)
                {
                    <p class="wb-muted">还没有产出记录。</p>
                }
                else
                {
                    <div class="wb-table-scroll">
                        <table class="wb-table">
                            <thead>
                            <tr><th>时间</th><th>类型</th><th>内容</th><th>任务</th><th>项目</th></tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Activity)
                            {
                                <tr>
                                    <td class="wb-muted" title="@Absolute(item.At)">@Relative(item.At)</td>
                                    <td><span class="wb-chip @(item.IsFile ? "wb-chip-ok" : "wb-chip-warn")">@(item.IsFile ? "代码改动" : "数据库")</span></td>
                                    <td>@item.Text</td>
                                    <td>
                                        @if (item.TaskId is not null)
                                        {
                                            <a href="/tasks/@item.TaskId">@item.TaskLabel</a>
                                        }
                                        else
                                        {
                                            <span class="wb-muted">—</span>
                                        }
                                    </td>
                                    <td class="wb-muted">@item.ProjectName</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <p class="wb-muted wb-mt-2">
                        <a href="/db-calls">看全部数据库调用</a>
                    </p>
                }
            </div>
        }
    }
    else
    {
        <!-- 项目：清单 + 每个项目的体检 -->
        <div class="wb-panel">
            <div class="wb-card-head">
                <h3>项目</h3>
                <button class="wb-btn wb-btn-primary" @onclick="ToggleCreate">@(ShowCreate ? "取消" : "新建项目")</button>
            </div>

            @if (ShowCreate)
            {
                <div class="wb-my-3">
                    <div class="wb-form-row">
                        <input class="wb-input" placeholder="项目名称" @bind="NewName" @bind:event="oninput" />
                        <input class="wb-input" placeholder="描述（可选）" @bind="NewDescription" @bind:event="oninput" />
                    </div>
                    <div class="wb-form-row">
                        <input class="wb-input" placeholder="本地仓库路径（绝对路径，如 /Users/you/code/your-repo）"
                               @bind="NewRepoPath" @bind:event="oninput" />
                    </div>
                    <p class="wb-muted">
                        填了仓库路径，agent 在这个目录里干活就会自动落到本项目 —— 不用再自己传项目 ID。
                    </p>
                    <button class="wb-btn wb-btn-primary" disabled="@(string.IsNullOrWhiteSpace(NewName) || Creating)" @onclick="CreateAsync">创建</button>
                </div>
                <ErrorNotice Error="@CreateError" />
            }

            @if (Data is null || Data.Projects.Count == 0)
            {
                <p class="wb-muted">还没有项目。</p>
            }
            else
            {
                <p class="wb-muted">点进度看这个项目的体检 —— 流速、周期、测试通过率、阻塞与停滞。</p>
                <div class="wb-table-scroll wb-mt-3">
                    <table class="wb-table wb-project-table">
                        <thead>
                        <tr>
                            <th>项目</th><th>进度</th><th>仓库绑定</th><th>任务</th>
                            <th class="wb-col-path">仓库路径</th><th class="wb-col-desc">描述</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var project in Data.Projects)
                        {
                            var metrics = MetricsFor(project.Id);
                            <tr>
                                <td><a class="wb-task-title" href="/projects/@project.Id">@project.Name</a></td>
                                <td>
                                    @if (metrics is { } m)
                                    {
                                        <button class="wb-btn wb-btn-link" @onclick="() => ToggleExpand(project.Id)">
                                            @Percent(m.Progress)
                                            <span class="wb-caret">@(_expandedProject == project.Id ? "▴" : "▾")</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="wb-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(project.RepoRoot))
                                    {
                                        <span class="wb-tag wb-tag-warn">没绑仓库</span>
                                    }
                                    else
                                    {
                                        <span class="wb-tag wb-tag-ok">已绑仓库</span>
                                    }
                                </td>
                                <td>
                                    <span class="wb-chip">@project.TotalTasks 个任务</span>
                                    @if (project.TotalTasks == 0)
                                    {
                                        <span class="wb-chip wb-chip-warn">还没有任务</span>
                                    }
                                </td>
                                <td class="wb-muted wb-col-path">@(string.IsNullOrWhiteSpace(project.RepoPath) ? "—" : project.RepoPath)</td>
                                <td class="wb-muted wb-col-desc">@(string.IsNullOrWhiteSpace(project.Description) ? "—" : project.Description)</td>
                            </tr>
                            @if (_expandedProject == project.Id && metrics is { } open)
                            {
                                <tr class="wb-metric-row">
                                    <td colspan="6">
                                        <div class="wb-metric-grid">
                                            <div class="wb-metric">
                                                <span class="wb-metric-label">完成 / 总数</span>
                                                <span class="wb-metric-value">@open.DoneTasks / @open.TotalTasks</span>
                                            </div>
                                            <div class="wb-metric">
                                                <span class="wb-metric-label">平均周期</span>
                                                <span class="wb-metric-value">@(open.AvgCycleHours is null ? "—" : Hours(open.AvgCycleHours.Value))</span>
                                            </div>
                                            <div class="wb-metric">
                                                <span class="wb-metric-label">测试通过率</span>
                                                <span class="wb-metric-value">@(open.TestPassRate is null ? "—" : Percent(open.TestPassRate.Value))</span>
                                            </div>
                                            <div class="wb-metric">
                                                <span class="wb-metric-label">平均覆盖率</span>
                                                <span class="wb-metric-value">@(open.AvgTestCoverage is null ? "—" : Percent(open.AvgTestCoverage.Value))</span>
                                            </div>
                                            <div class="wb-metric">
                                                <span class="wb-metric-label">进行中</span>
                                                <span class="wb-metric-value">@open.ActiveTasks</span>
                                            </div>
                                            <div class="wb-metric">
                                                <span class="wb-metric-label">阻塞 / 停滞</span>
                                                <span class="wb-metric-value">@open.BlockedTasks / @open.StaleTasks</span>
                                            </div>
                                        </div>

                                        <h4>状态分布</h4>
                                        <div class="wb-form-row">
                                            @foreach (var s in open.StatusCounts)
                                            {
                                                <span class="wb-chip">@UiText.Status(s.Status) @s.Count</span>
                                            }
                                        </div>

                                        <h4>近 8 周流速</h4>
                                        @if (open.Throughput.Count == 0 || open.Throughput.Max(p => p.Completed) <= 0)
                                        {
                                            @* 八周全是 0 时画一排贴底的横杠，看着像「有一点点数据」—— 直接说没有 *@
                                            <p class="wb-muted">近 8 周没有完成的任务。</p>
                                        }
                                        else
                                        {
                                            <div class="wb-bars">
                                                @foreach (var point in open.Throughput)
                                                {
                                                    var max = open.Throughput.Max(p => p.Completed);
                                                    var height = point.Completed <= 0
                                                        ? 2
                                                        : Math.Max(4, (int)Math.Round(point.Completed * 100d / max));
                                                    <div class="wb-bar-col" title="@(point.Week) 完成 @point.Completed">
                                                        <div class="wb-bar @(point.Completed <= 0 ? "wb-bar-zero" : "")" style="height:@(height)px"></div>
                                                        <span class="wb-bar-label">@point.Completed</span>
                                                        <span class="wb-bar-week">@point.Week[5..]</span>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}

@code {
    /// <summary>最近产出里的一行。代码改动与数据库调用合成一条流水。</summary>
    private sealed record ActivityItem(
        DateTimeOffset At,
        bool IsFile,
        string Text,
        Guid? TaskId,
        string TaskLabel,
        string ProjectName);

    /// <summary>页签。URL 是唯一真相 —— 「/?tab=projects」能直接落地。</summary>
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private OverviewDto? Data { get; set; }
    private IReadOnlyList<ActivityItem> Activity { get; set; } = [];
    private IReadOnlyList<ProjectMetricsDto> Metrics { get; set; } = [];
    private bool Loading { get; set; } = true;
    private bool ShowCreate { get; set; }
    private bool Creating { get; set; }
    private string NewName { get; set; } = string.Empty;
    private string NewDescription { get; set; } = string.Empty;
    private string NewRepoPath { get; set; } = string.Empty;
    private PageError? LoadError { get; set; }
    private PageError? CreateError { get; set; }

    /// <summary>展开体检详情的那一行。只展开一个 —— 展开两个会让人不知道在看谁。</summary>
    private Guid? _expandedProject;

    private string ActiveTab => Tab == "projects" ? "projects" : "now";

    /// <summary>自动刷新间隔。agent 在干活时页面得自己动起来。</summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(15);

    private CancellationTokenSource? _timerCts;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // 只在交互阶段起定时器：预渲染出来的实例用完就扔。
        if (firstRender)
        {
            _timerCts = new CancellationTokenSource();
            _ = RunRefreshTimerAsync(_timerCts.Token);
        }

        return Task.CompletedTask;
    }

    private void GoTab(string tab) => Nav.NavigateTo($"/?tab={tab}");

    private void GoNow() => GoTab("now");

    private void GoProjects() => GoTab("projects");

    private ProjectMetricsDto? MetricsFor(Guid projectId) =>
        Metrics.FirstOrDefault(m => m.ProjectId == projectId);

    private void ToggleExpand(Guid projectId) =>
        _expandedProject = _expandedProject == projectId ? null : projectId;

    /// <summary>
    /// 自动刷新。每 tick 独立 scope —— 定时器与页面上的写操作共用电路级
    /// DbContext 的话，两个操作撞上就是 "A second operation was started"。
    /// </summary>
    private async Task RunRefreshTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(RefreshInterval);

            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // 组件被销毁，正常收尾
        }
        catch (ObjectDisposedException)
        {
            // 电路已经断了
        }
    }

    private async Task ReloadAsync()
    {
        Loading = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var overview = scope.ServiceProvider.GetRequiredService<IOverviewService>();
            Data = await overview.GetAsync();
            Activity = BuildActivity(Data);

            // 度量是每个项目一行的体检，跟项目清单放一起看。
            var metrics = scope.ServiceProvider.GetRequiredService<IMetricsService>();
            Metrics = await metrics.GetAllAsync();

            LoadError = null;
        }
        catch (Exception ex)
        {
            LoadError = PageError.From(ex, "加载总览");
        }
        finally
        {
            Loading = false;
        }
    }

    /// <summary>把「代码改动」和「数据库调用」合成一条按时间倒序的流水。</summary>
    private static IReadOnlyList<ActivityItem> BuildActivity(OverviewDto data)
    {
        var items = new List<ActivityItem>();

        foreach (var file in data.RecentFiles)
        {
            items.Add(new ActivityItem(
                file.CreatedAt,
                true,
                $"{file.Path}（+{file.LinesAdded} / -{file.LinesDeleted}）",
                file.TaskId,
                UiText.TaskRef(file.TaskKey),
                file.ProjectName));
        }

        foreach (var call in data.RecentDbCalls)
        {
            var target = string.IsNullOrWhiteSpace(call.Database)
                ? "—"
                : $"{call.Database}";

            items.Add(new ActivityItem(
                call.CreatedAt,
                false,
                $"{target} · {Truncate(call.Sql, 60)}",
                call.TaskId,
                UiText.TaskRef(call.TaskKey),
                call.ProjectName ?? "—"));
        }

        return items.OrderByDescending(i => i.At).Take(20).ToList();
    }

    private void ToggleCreate()
    {
        ShowCreate = !ShowCreate;
        CreateError = null;
    }

    private async Task CreateAsync()
    {
        if (Creating)
        {
            return;
        }

        Creating = true;
        StateHasChanged();

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var projects = scope.ServiceProvider.GetRequiredService<IProjectService>();

            await projects.CreateAsync(
                NewName,
                string.IsNullOrWhiteSpace(NewDescription) ? null : NewDescription,
                repoPath: string.IsNullOrWhiteSpace(NewRepoPath) ? null : NewRepoPath);

            NewName = string.Empty;
            NewDescription = string.Empty;
            NewRepoPath = string.Empty;
            ShowCreate = false;
            CreateError = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            CreateError = PageError.From(ex, "新建项目");
        }
        finally
        {
            Creating = false;
        }
    }

    private static string Relative(DateTimeOffset time)    {
        var delta = DateTimeOffset.UtcNow - time;
        if (delta.TotalMinutes < 1) return "刚刚";
        if (delta.TotalHours < 1) return $"{(int)delta.TotalMinutes} 分钟前";
        if (delta.TotalDays < 1) return $"{(int)delta.TotalHours} 小时前";
        return $"{(int)delta.TotalDays} 天前";
    }

    private static string Truncate(string? text, int max = 60)
    {
        if (string.IsNullOrEmpty(text))
        {
            return "—";
        }

        return text.Length <= max ? text : text[..max] + "…";
    }

    /// <summary>绝对时间。相对时间（「3 天前」）看不出是哪天，鼠标停上去要能看到。</summary>
    private static string Absolute(DateTimeOffset time) =>
        time.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string Percent(double ratio) => $"{ratio * 100:0.#}%";

    private static string Hours(double hours) => hours < 24
        ? $"{hours:0.#} 小时"
        : $"{hours / 24:0.#} 天";

    public async ValueTask DisposeAsync()
    {
        if (_timerCts is not null)
        {
            await _timerCts.CancelAsync();
            _timerCts.Dispose();
            _timerCts = null;
        }
    }
}
