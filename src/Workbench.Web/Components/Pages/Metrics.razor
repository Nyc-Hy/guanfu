@page "/metrics"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>总览 · 开发工作台</PageTitle>

@* 度量页已经并进总览页的「项目」页签。
   这个路由留着，是为了别让人收藏的链接直接 404 —— 落过去就行。 *@

@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return Task.CompletedTask;
        }

        // 预渲染阶段不能导航 —— 那时候浏览器还没接手，
        // 导航只能在第一次渲染之后做。
        Nav.NavigateTo("/?tab=projects", replace: true);
        return Task.CompletedTask;
    }
}
