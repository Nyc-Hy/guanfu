@page "/db-calls"
@rendermode InteractiveServer
@inject IDbCallService Calls
@inject IProjectService Projects
@inject IDbConnectionService Connections

<PageTitle>数据库调用 · 开发工作台</PageTitle>

<div class="wb-page-head">
    <div>
        <h1>数据库调用</h1>
        <p class="wb-muted">
            agent 每次对数据库下手都记一笔：谁调的、对哪个库、跑的什么 SQL、动了哪张表、
            影响几行、谁批的。出问题从这里复盘。
        </p>
    </div>
    <button class="wb-btn" disabled="@Loading" @onclick="() => ReloadAsync(resetPage: true)">刷新</button>
</div>

<ErrorNotice Error="LoadError" />

<div class="wb-filter-bar">
    <select class="wb-input" title="项目" aria-label="项目" @bind="ProjectFilter" @bind:after="OnProjectChangedAsync">
        <option value="">全部项目</option>
        @foreach (var project in ProjectList)
        {
            <option value="@project.Id">@project.Name</option>
        }
    </select>
    <select class="wb-input" title="连接" aria-label="连接" @bind="ConnectionFilter" @bind:after="() => ReloadAsync(resetPage: true)">
        <option value="">全部连接</option>
        @foreach (var conn in VisibleConnections)
        {
            <option value="@conn.Id">@ConnectionLabel(conn)</option>
        }
    </select>
    <input class="wb-input" type="text" placeholder="库名" title="库名" aria-label="库名"
           @bind="DatabaseFilter" @bind:after="() => ReloadAsync(resetPage: true)" />
    <input class="wb-input" type="text" placeholder="表名" title="表名" aria-label="表名"
           @bind="TableFilter" @bind:after="() => ReloadAsync(resetPage: true)" />
    <input class="wb-input" type="text" placeholder="SQL 里包含" title="SQL 里包含" aria-label="SQL 里包含"
           @bind="SqlFilter" @bind:after="() => ReloadAsync(resetPage: true)" />
    <select class="wb-input" @bind="KindFilter" @bind:after="() => ReloadAsync(resetPage: true)">
        <option value="">全部读写类型</option>
        <option value="Read">读</option>
        <option value="Write">写</option>
        <option value="Unknown">未知</option>
    </select>
    <div class="wb-date-range">
        <input class="wb-input" type="date" title="起始日期" aria-label="起始日期" @bind="FromDate"
               @bind:after="() => ReloadAsync(resetPage: true)" />
        <span class="wb-muted">至</span>
        <input class="wb-input" type="date" title="结束日期" aria-label="结束日期" @bind="ToDate"
               @bind:after="() => ReloadAsync(resetPage: true)" />
    </div>
</div>

@if (Loading && Rows.Count == 0)
{
    <div class="wb-loading">加载中…</div>
}
else if (Rows.Count == 0)
{
    <div class="wb-empty">没有符合条件的数据库调用记录。</div>
}
else
{
    <div class="wb-table-scroll">
        <table class="wb-table">
            <thead>
            <tr>
                <th>时间</th>
                <th>项目</th>
                <th>任务</th>
                <th>连接与目标库</th>
                <th>SQL</th>
                <th>读写与结果</th>
                <th>目标表</th>
                <th>影响行数</th>
                <th>调用方与审批</th>
                <th>耗时</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    <td class="wb-muted">@row.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        <a href="/projects/@row.ProjectId">@(string.IsNullOrWhiteSpace(row.ProjectName) ? "未命名项目" : row.ProjectName)</a>
                    </td>
                    <td>
                        @if (row.TaskId is not null)
                        {
                            <a href="/tasks/@row.TaskId">@UiText.TaskRef(row.TaskKey)</a>
                        }
                        else
                        {
                            <span class="wb-muted">未关联任务</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(ConnectionName(row.ConnectionId)))
                        {
                            <div>@ConnectionName(row.ConnectionId)</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(row.Server) || !string.IsNullOrWhiteSpace(row.Database))
                        {
                            <div class="wb-muted"><code>@ServerText(row)</code></div>
                        }
                        @if (string.IsNullOrWhiteSpace(ConnectionName(row.ConnectionId))
                            && string.IsNullOrWhiteSpace(row.Server)
                            && string.IsNullOrWhiteSpace(row.Database))
                        {
                            <span class="wb-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(row.Sql))
                        {
                            <span class="wb-muted">—</span>
                        }
                        else
                        {
                            <pre class="wb-sql">@ShortSql(row.Sql)</pre>
                            @if (row.Sql.Length > SqlPreviewLength)
                            {
                                <details>
                                    <summary class="wb-muted">查看全文</summary>
                                    <pre class="wb-sql">@row.Sql</pre>
                                </details>
                            }
                        }
                    </td>
                    <td>
                        <span class="wb-tag @KindClass(row.Kind)">@KindLabel(row.Kind)</span>
                        <span class="wb-tag @OutcomeClass(row.Outcome)">@OutcomeLabel(row.Outcome)</span>
                    </td>
                    <td>
                        @if (row.TargetTables.Count == 0)
                        {
                            <span class="wb-muted">—</span>
                        }
                        else
                        {
                            @foreach (var table in row.TargetTables)
                            {
                                <span class="wb-chip">@table</span>
                            }
                        }
                    </td>
                    <td>
                        @if (row.RowsAffected is null)
                        {
                            <span class="wb-muted">—</span>
                        }
                        else
                        {
                            @row.RowsAffected
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(row.CallerId))
                        {
                            <span class="wb-muted">—</span>
                        }
                        else
                        {
                            <span class="wb-chip wb-chip-agent">@row.CallerId</span>
                        }
                        @if (row.ApprovalId is null)
                        {
                            <span class="wb-chip wb-chip-muted">无需审批</span>
                        }
                        else
                        {
                            <a class="wb-chip wb-chip-warn" href="/approvals?id=@row.ApprovalId">已审批</a>
                        }
                    </td>
                    <td class="wb-muted">@row.DurationMs ms</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="wb-pager">
        <button class="wb-btn" disabled="@(Loading || PageIndex == 0)" @onclick="PrevPageAsync">上一页</button>
        <span class="wb-muted">第 @(PageIndex + 1) 页</span>
        <button class="wb-btn" disabled="@(Loading || !HasNext)" @onclick="NextPageAsync">下一页</button>
        <span class="wb-muted">共 @Total 条</span>
        @if (Loading)
        {
            <span class="wb-muted">加载中…</span>
        }
    </div>
}

@code {
    private const int PageSize = 50;

    // 注入的 IDbCallService 属性叫 Calls 而不是 DbCalls ——
    // 页面类本身就叫 DbCalls，同名成员编译不过（CS0542）。

    /// <summary>表格里 SQL 预览的长度；超出的部分折叠在「查看全文」里。</summary>
    private const int SqlPreviewLength = 120;

    private sealed record ConnectionOption(Guid Id, Guid ProjectId, string Name, string Server, string Database);

    private IReadOnlyList<DbCallRecordDto> Rows { get; set; } = [];
    private IReadOnlyList<ProjectSummaryDto> ProjectList { get; set; } = [];
    private IReadOnlyList<ConnectionOption> AllConnections { get; set; } = [];

    private string ProjectFilter { get; set; } = string.Empty;
    private string ConnectionFilter { get; set; } = string.Empty;
    private string DatabaseFilter { get; set; } = string.Empty;
    private string TableFilter { get; set; } = string.Empty;
    private string SqlFilter { get; set; } = string.Empty;
    private string KindFilter { get; set; } = string.Empty;
    private DateTime? FromDate { get; set; }
    private DateTime? ToDate { get; set; }

    /// <summary>
    /// 深链参数：/db-calls?sql=xxx
    ///
    /// 全局搜索搜到一条 SQL 后点过来，要能直接看到「这条 SQL 跑过哪些次」，
    /// 而不是让人重新填一遍筛选条件。
    /// </summary>
    [SupplyParameterFromQuery(Name = "sql")]
    public string? SqlQuery { get; set; }

    private int PageIndex { get; set; }
    private int Total { get; set; }
    private bool Loading { get; set; } = true;
    private bool _reloading;
    private PageError? LoadError { get; set; }

    /// <summary>选了项目就只看这个项目的连接；没选就全列。</summary>
    private IEnumerable<ConnectionOption> VisibleConnections =>
        Guid.TryParse(ProjectFilter, out var projectId)
            ? AllConnections.Where(c => c.ProjectId == projectId)
            : AllConnections;

    private bool HasNext => (PageIndex + 1) * PageSize < Total;

    protected override async Task OnInitializedAsync()
    {
        // 深链带来的 SQL 关键词直接填进筛选框
        if (!string.IsNullOrWhiteSpace(SqlQuery))
        {
            SqlFilter = SqlQuery.Trim();
        }

        // 过滤选项的数据源。失败不拦记录查询本身，只是下拉为空。
        try
        {
            ProjectList = await Projects.ListAsync();
            AllConnections = await LoadConnectionsAsync();
            LoadError = null;
        }
        catch (Exception ex)
        {
            LoadError = PageError.From(ex, "加载过滤选项");
        }

        await ReloadAsync(resetPage: true);
    }

    /// <summary>项目下的连接列表（连接只属于项目，只能按项目取）。</summary>
    private async Task<IReadOnlyList<ConnectionOption>> LoadConnectionsAsync()
    {
        var options = new List<ConnectionOption>();

        foreach (var project in ProjectList)
        {
            var connections = await Connections.ListAsync(project.Id);
            foreach (var connection in connections)
            {
                options.Add(new ConnectionOption(
                    connection.Id, project.Id, connection.Name, connection.Server, connection.Database));
            }
        }

        return options;
    }

    private async Task OnProjectChangedAsync()
    {
        // 换了项目，之前选的连接可能不属于它了 —— 清掉，避免筛出空结果。
        if (!string.IsNullOrWhiteSpace(ConnectionFilter) &&
            !VisibleConnections.Any(c => c.Id.ToString() == ConnectionFilter))
        {
            ConnectionFilter = string.Empty;
        }

        await ReloadAsync(resetPage: true);
    }

    private async Task ReloadAsync(bool resetPage)
    {
        // 连点 / 过滤连改：上一次查询还没回来就不再叠一次
        if (_reloading)
        {
            return;
        }

        if (resetPage)
        {
            PageIndex = 0;
        }

        _reloading = true;
        Loading = true;
        StateHasChanged();

        try
        {
            Guid? projectId = Guid.TryParse(ProjectFilter, out var parsedProject) ? parsedProject : null;
            Guid? connectionId = Guid.TryParse(ConnectionFilter, out var parsedConnection) ? parsedConnection : null;

            var (rows, total) = await Calls.ListAsync(
                projectId: projectId,
                connectionId: connectionId,
                database: string.IsNullOrWhiteSpace(DatabaseFilter) ? null : DatabaseFilter.Trim(),
                table: string.IsNullOrWhiteSpace(TableFilter) ? null : TableFilter.Trim(),
                kind: string.IsNullOrWhiteSpace(KindFilter) ? null : KindFilter,
                taskId: null,
                from: ToUtcStart(FromDate),
                to: ToUtcEnd(ToDate),
                limit: PageSize,
                offset: PageIndex * PageSize,
                sql: string.IsNullOrWhiteSpace(SqlFilter) ? null : SqlFilter.Trim());

            Rows = rows;
            Total = total;
            LoadError = null;
        }
        catch (Exception ex)
        {
            LoadError = PageError.From(ex, "加载数据库调用记录");
        }
        finally
        {
            Loading = false;
            _reloading = false;
        }
    }

    private async Task PrevPageAsync()
    {
        if (PageIndex == 0)
        {
            return;
        }

        PageIndex--;
        await ReloadAsync(resetPage: false);
    }

    private async Task NextPageAsync()
    {
        if (!HasNext)
        {
            return;
        }

        PageIndex++;
        await ReloadAsync(resetPage: false);
    }

    /// <summary>连接名（没有连接就空着 —— 跟目标库挤在一格里，「—srv01.shop」读起来费劲）。</summary>
    private string ConnectionName(Guid? connectionId)
    {
        if (connectionId is null)
        {
            return string.Empty;
        }

        var found = AllConnections.FirstOrDefault(c => c.Id == connectionId.Value);
        return found is null ? "未命名连接" : found.Name;
    }

    /// <summary>server.database（缺哪半就省哪半）。</summary>
    private static string ServerText(DbCallRecordDto row)
    {
        if (string.IsNullOrWhiteSpace(row.Server))
        {
            return row.Database ?? string.Empty;
        }

        return string.IsNullOrWhiteSpace(row.Database)
            ? row.Server
            : $"{row.Server}.{row.Database}";
    }

    private string ConnectionLabel(ConnectionOption connection)
    {
        var projectName = ProjectList.FirstOrDefault(p => p.Id == connection.ProjectId)?.Name;
        return string.IsNullOrWhiteSpace(projectName)
            ? connection.Name
            : $"{projectName} / {connection.Name}";
    }

    /// <summary>SQL 预览：压掉空白再截断，免得一行撑爆表格。</summary>
    private static string ShortSql(string sql)
    {
        var collapsed = string.Join(' ', sql.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));
        return collapsed.Length <= SqlPreviewLength
            ? collapsed
            : string.Concat(collapsed.AsSpan(0, SqlPreviewLength - 1), "…");
    }

    /// <summary>起始日期（本地）→ UTC 区间起点。</summary>
    private static DateTimeOffset? ToUtcStart(DateTime? localDate) =>
        localDate is null ? null : ToLocalOffset(localDate.Value);

    /// <summary>结束日期（本地）→ UTC 区间终点（含当天最后一刻）。</summary>
    private static DateTimeOffset? ToUtcEnd(DateTime? localDate) =>
        localDate is null ? null : ToLocalOffset(localDate.Value).AddDays(1).AddTicks(-1);

    /// <summary>本地时间 → 带本地偏移的 DateTimeOffset（转换器会再转成 UTC 存储）。</summary>
    private static DateTimeOffset ToLocalOffset(DateTime localDate)
    {
        var unspecified = DateTime.SpecifyKind(localDate, DateTimeKind.Unspecified);
        return new DateTimeOffset(unspecified, TimeZoneInfo.Local.GetUtcOffset(unspecified));
    }

    private static string KindLabel(string? kind) => kind switch
    {
        "Read" => "读",
        "Write" => "写",
        "Unknown" => "未知",
        _ => string.IsNullOrWhiteSpace(kind) ? "—" : kind
    };

    private static string KindClass(string? kind) => kind switch
    {
        "Read" => "wb-tag-ok",
        "Write" => "wb-tag-warn",
        "Unknown" => "wb-tag-danger",
        _ => string.Empty
    };

    private static string OutcomeLabel(string? outcome) => outcome switch
    {
        "success" => "成功",
        "denied" => "已拒绝",
        "error" => "错误",
        "pending" => "待审批",
        _ => string.IsNullOrWhiteSpace(outcome) ? "—" : outcome
    };

    private static string OutcomeClass(string? outcome) => outcome switch
    {
        "success" => "wb-tag-ok",
        "denied" => "wb-tag-danger",
        "error" => "wb-tag-danger",
        "pending" => "wb-tag-warn",
        _ => string.Empty
    };
}
