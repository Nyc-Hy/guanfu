@page "/workspace"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using Workbench.Infrastructure
@inject IWorkspaceArchiver Archiver
@inject IOptions<WorkbenchOptions> Options

<PageTitle>工作区搬迁 · 开发工作台</PageTitle>

<div class="wb-page-head">
    <div>
        <h1>工作区搬迁</h1>
        <p class="wb-muted">
            换电脑时把整个工作区打包带走：数据库、文档原件、加密密钥、agent 运行日志。
            当前 WORKBENCH_HOME：<code>@Options.Value.HomeDirectory</code>
        </p>
    </div>
</div>

<PageTokenGate @bind-Authorized="Authorized" />

<ErrorNotice Error="ActionError" />
<ErrorNotice Error="Notice" />

<div class="wb-detail-grid">
    <div class="wb-detail-main">
        <section class="wb-panel">
            <h3>导出工作区</h3>
            <p class="wb-muted">
                把当前工作区导出到一个目录，整个目录拷到新机器即可。
                数据库用 SQLite 快照导出，边跑边导也不会拿到半截文件。
            </p>
            <div class="wb-field-row">
                <label class="wb-label">导出目录</label>
                <input class="wb-input" placeholder="/Users/you/backup/workbench-export"
                       disabled="@Busy" @bind="ExportDirectory" @bind:event="oninput" />
            </div>
            <p class="wb-hint">
                目录必须为空或只含上一次的导出产物，且不能位于 WORKBENCH_HOME 里面。
            </p>

            @if (!ExportConfirming)
            {
                <div class="wb-field-row">
                    <div class="wb-field-ctl">
                        <button class="wb-btn wb-btn-primary"
                                disabled="@(!Authorized || Busy || string.IsNullOrWhiteSpace(ExportDirectory))"
                                @onclick="() => ExportConfirming = true">导出…</button>
                        @if (!Authorized)
                        {
                            <span class="wb-muted">需要先在上方验证人工凭证。</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="wb-alert wb-alert-warn">
                    <strong>导出前确认：</strong>导出物包含
                    <strong>数据库快照（workbench.db）、文档原件（documents/）、加密密钥（secret.key）、agent 运行日志（runs/）</strong>。
                    密钥能解开库里所有加密的数据库密码 —— 导出目录要放在只有你能访问的位置，
                    传输时请加密。目标目录里的同名旧导出产物会被替换。
                    <div class="wb-form-row wb-mt-3">
                        <button class="wb-btn wb-btn-primary" disabled="@(!Authorized || Busy)" @onclick="ExportAsync">
                            @(Exporting ? "导出中…" : "确认导出")
                        </button>
                        <button class="wb-btn" disabled="@Busy" @onclick="() => ExportConfirming = false">取消</button>
                    </div>
                </div>
            }
        </section>

        <section class="wb-panel">
            <h3>导入工作区</h3>
            <p class="wb-muted">
                把一个导出目录恢复到新的 WORKBENCH_HOME。导入完成后，
                把环境变量 WORKBENCH_HOME 指到目标目录再启动服务。
            </p>
            <div class="wb-field-row">
                <label class="wb-label">导出源目录</label>
                <input class="wb-input" placeholder="/Users/you/backup/workbench-export"
                       disabled="@Busy" @bind="ImportSourceDirectory" @bind:event="oninput" />
            </div>
            <div class="wb-field-row">
                <label class="wb-label">目标 HOME</label>
                <input class="wb-input" placeholder="/Users/you/.workbench-restored"
                       disabled="@Busy" @bind="ImportTargetDirectory" @bind:event="oninput" />
            </div>

            <div class="wb-alert">
                <strong>覆盖警告：</strong>导入会<strong>覆盖目标目录里的同名数据</strong>（数据库、文档、密钥、运行日志）。
                目标目录里已有的工作台数据会被导出物替换，且无法撤销。
                不能导入到正在运行的 WORKBENCH_HOME —— 那会把正在用的库覆盖掉。
            </div>

            <div class="wb-field-row">
                <label class="wb-label">强确认</label>
                <input class="wb-input" placeholder="输入「覆盖导入」四个字以确认"
                       disabled="@Busy" @bind="ImportConfirmText" @bind:event="oninput" />
            </div>
            <div class="wb-field-row">
                <div class="wb-field-ctl">
                    <button class="wb-btn wb-btn-danger" disabled="@(!CanImport)" @onclick="ImportAsync">
                        @(Importing ? "导入中…" : "覆盖导入")
                    </button>
                    @if (!Authorized)
                    {
                        <span class="wb-muted">需要先在上方验证人工凭证。</span>
                    }
                </div>
            </div>
        </section>
    </div>

    <aside class="wb-detail-side">
        <section class="wb-panel">
            <h3>导出物里有什么</h3>
            <ul class="wb-outline">
                <li><code>workbench.db</code> —— 任务、审批、调用记录、连接配置（数据库快照）</li>
                <li><code>documents/</code> —— 上传的文档原件</li>
                <li><code>secret.key</code> —— 加密密钥（丢了就解不开库里的数据库密码）</li>
                <li><code>runs/</code> —— 外部 agent 的运行日志</li>
                <li><code>manifest.json</code> —— 导出清单（时间、来源、文件说明）</li>
            </ul>
            <p class="wb-hint">
                密钥文件权限会按源文件恢复（0600）。导出物等同于整个工作区的明文副本，请妥善保管。
            </p>
        </section>
    </aside>
</div>

@code {
    private bool Authorized { get; set; }

    private string ExportDirectory { get; set; } = string.Empty;
    private bool ExportConfirming { get; set; }
    private bool Exporting { get; set; }

    private string ImportSourceDirectory { get; set; } = string.Empty;
    private string ImportTargetDirectory { get; set; } = string.Empty;
    private string ImportConfirmText { get; set; } = string.Empty;
    private bool Importing { get; set; }

    private bool Busy => Exporting || Importing;

    /// <summary>强确认：必须原样输入「覆盖导入」才放行。</summary>
    private bool CanImport =>
        Authorized && !Busy
        && ImportConfirmText.Trim() == "覆盖导入"
        && !string.IsNullOrWhiteSpace(ImportSourceDirectory)
        && !string.IsNullOrWhiteSpace(ImportTargetDirectory);

    private PageError? ActionError { get; set; }
    private PageError? Notice { get; set; }

    private async Task ExportAsync()
    {
        if (!Authorized || Busy)
        {
            return;
        }

        Exporting = true;
        ActionError = null;
        Notice = null;
        StateHasChanged();

        try
        {
            // 与 REST 入口同一道前置校验（导出目录不能是 HOME 本身 / 文档目录里面）
            var invalid = WorkspacePathGuard.ValidateExportTarget(ExportDirectory, Options.Value);
            if (invalid is not null)
            {
                ActionError = PageError.Simple(invalid);
                return;
            }

            var result = await Archiver.ExportAsync(ExportDirectory);
            Notice = PageError.Notice(result.Message);
            ExportConfirming = false;
        }
        catch (WorkbenchException ex)
        {
            // 业务错误显示原文（「导出目录里已有非导出文件…」这类）
            ActionError = PageError.Simple(ex.Message);
        }
        catch (Exception ex)
        {
            ActionError = PageError.From(ex, "导出工作区");
        }
        finally
        {
            Exporting = false;
        }
    }

    private async Task ImportAsync()
    {
        if (!Authorized || Busy || ImportConfirmText.Trim() != "覆盖导入")
        {
            return;
        }

        Importing = true;
        ActionError = null;
        Notice = null;
        StateHasChanged();

        try
        {
            var invalid = WorkspacePathGuard.ValidateImportTarget(ImportTargetDirectory, Options.Value);
            if (invalid is not null)
            {
                ActionError = PageError.Simple(invalid);
                return;
            }

            var result = await Archiver.ImportAsync(ImportSourceDirectory, ImportTargetDirectory);
            Notice = PageError.Notice(result.Message);
            ImportConfirmText = string.Empty;
        }
        catch (WorkbenchException ex)
        {
            ActionError = PageError.Simple(ex.Message);
        }
        catch (Exception ex)
        {
            ActionError = PageError.From(ex, "导入工作区");
        }
        finally
        {
            Importing = false;
        }
    }
}