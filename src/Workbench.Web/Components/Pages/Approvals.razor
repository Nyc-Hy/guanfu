@page "/approvals"
@rendermode InteractiveServer
@using System.Text.Json
@using Microsoft.AspNetCore.Http
@inject IApprovalService ApprovalService
@inject HumanTokenAccessor Tokens
@inject IJSRuntime JS

<PageTitle>审批 · 开发工作台</PageTitle>

<div class="wb-page-head">
    <h1>审批</h1>
    <button class="wb-btn" @onclick="RefreshAsync">刷新</button>
</div>

@* 数据没加载出来时也要有话说，不能白屏 *@
<ErrorNotice Error="LoadError" />

@* 裁决的错误放在列表外面：裁决成功后列表会重画，
   错误提示写在每张卡片里的话，一刷新就没了。 *@
<ErrorNotice Error="ActionError" />

@if (!Authorized)
{
    <div class="wb-panel">
        <p class="wb-error">@ApprovalUiGuard.MissingTokenMessage</p>
        <p class="wb-muted">
            在本机打开工作台时会自动获取；远程访问请从启动工作台的控制台复制人工 token，粘贴到下面。
        </p>
        <div class="wb-form-row">
            @* 不用 @bind：绑定的值会被 Blazor 写回 DOM 的 value 属性，
               那是把钥匙摊在页面上。这里只在事件里收值。 *@
            <input class="wb-input" type="password" placeholder="人工 token（控制台里那串）"
                   @oninput="OnTokenInputChanged" />
            <button class="wb-btn wb-btn-primary"
                    disabled="@string.IsNullOrWhiteSpace(TokenInput)"
                    @onclick="VerifyTokenAsync">验证</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(TokenHint))
        {
            <p class="wb-hint">@TokenHint</p>
        }
    </div>
}

@if (Items.Count == 0)
{
    <div class="wb-empty">没有待处理的审批。</div>
}
else
{
    <div class="wb-approval-list">
        @foreach (var approval in Items)
        {
            <div class="wb-panel">
                <div class="wb-card-head">
                    <div>
                        <strong>@approval.ToolName</strong>
                        <span class="wb-chip">@approval.Kind</span>
                        @if (!string.IsNullOrWhiteSpace(approval.RequestedBy))
                        {
                            <span class="wb-chip wb-chip-agent">@approval.RequestedBy</span>
                        }
                    </div>
                    <span class="wb-chip wb-chip-muted">
                        等待 @Math.Max(0, (int)(approval.ExpiresAt - DateTimeOffset.UtcNow).TotalMinutes) 分钟
                    </span>
                </div>

                <p class="wb-muted">@approval.Summary</p>

                <pre class="wb-sql">@approval.Payload</pre>

                <div class="wb-form-row">
                    <input class="wb-input" placeholder="驳回理由（驳回必填）" @bind="Reason" @bind:event="oninput" />
                    <button class="wb-btn wb-btn-primary" disabled="@(!CanDecideNow)"
                            @onclick="() => DecideAsync(approval.Id, true)">批准</button>
                    <button class="wb-btn wb-btn-danger" disabled="@(!CanDecideNow)"
                            @onclick="() => DecideAsync(approval.Id, false)">驳回</button>
                </div>
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// 浏览器自己去取 token 的脚本。
    ///
    /// 必须由浏览器发起：服务端自己调用 /api/human-token 会把「请求来自本机」
    /// 这件事洗白 —— 远程用户也能拿到 token，门禁就没了。
    /// 远程访问时这个接口返回 403，于是退回「粘贴控制台里的 token」这条路。
    /// </summary>
    private const string FetchTokenScript =
        "fetch('/api/human-token',{credentials:'same-origin'})"
        + ".then(function(r){return r.text().then(function(t){return JSON.stringify({ok:r.ok,status:r.status,body:t});});})"
        + ".catch(function(){return JSON.stringify({ok:false,status:0,body:''});})";

    private IReadOnlyList<ApprovalDto> Items { get; set; } = [];
    private string Reason { get; set; } = string.Empty;

    private PageError? LoadError { get; set; }
    private PageError? ActionError { get; set; }

    // ---- 人工凭证 ----
    private bool Authorized { get; set; }
    private string TokenInput { get; set; } = string.Empty;
    private string? TokenHint { get; set; }

    // 连点保护：第二个点击到达时第一个可能还卡在 await 里
    private bool Submitting { get; set; }

    // 一条审批只裁决一次：Blazor 的事件是排队串行处理的，
    // 光靠「正在提交」标志挡不住已经排进队的第二次点击
    private readonly SubmitLatch _decisions = new();

    private bool CanDecideNow => Authorized && !Submitting;

    /// <summary>
    /// 服务端渲染阶段能看到请求本身（浏览器之前已经种过 Cookie 的情况）。
    /// 交互阶段拿不到（电路里没有 HttpContext），那时靠电路里记下的 token 判断。
    /// </summary>
    [CascadingParameter] public HttpContext? RequestContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        if (ApprovalUiGuard.CanDecide(RequestContext?.Request, Tokens.Token))
        {
            Authorized = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 预渲染阶段没有 JS 运行时，所以自动取 token 只能放在交互阶段
        if (!firstRender)
        {
            return;
        }

        await AcquireTokenAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            Items = await ApprovalService.ListAsync(ApprovalStatus.Pending);
            LoadError = null;
        }
        catch (Exception ex)
        {
            // 别让异常从初始化方法冒出去 —— 冒出去就是整页白屏
            LoadError = PageError.From(ex, "加载审批列表");
        }
    }

    /// <summary>自动取凭证：拿到就放行，拿不到就让人粘贴。</summary>
    private async Task AcquireTokenAsync()
    {
        if (Authorized)
        {
            return;
        }

        string? payload = null;

        try
        {
            payload = await JS.InvokeAsync<string>("eval", FetchTokenScript);
        }
        catch (JSException)
        {
            // 取不到就走粘贴流程，不影响页面其它功能
        }
        catch (InvalidOperationException)
        {
            // 预渲染阶段没有 JS 运行时
        }

        var token = ExtractToken(payload);

        if (token is not null && ApprovalUiGuard.CanDecide(token, Tokens.Token))
        {
            Authorized = true;
            TokenHint = null;
        }
        else
        {
            TokenHint = "没能自动取到人工凭证（远程访问时这是正常的）。请从启动工作台的控制台复制 token 粘贴到上面。";
        }

        StateHasChanged();
    }

    /// <summary>从浏览器拿回来的 JSON 里抠出 token。取不到就当没有。</summary>
    private static string? ExtractToken(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload))
        {
            return null;
        }

        try
        {
            using var outer = JsonDocument.Parse(payload);

            if (!outer.RootElement.TryGetProperty("ok", out var ok) || !ok.GetBoolean())
            {
                return null;
            }

            if (!outer.RootElement.TryGetProperty("body", out var body))
            {
                return null;
            }

            using var inner = JsonDocument.Parse(body.GetString() ?? "{}");

            if (!inner.RootElement.TryGetProperty("token", out var token))
            {
                return null;
            }

            var value = token.GetString();
            return string.IsNullOrWhiteSpace(value) ? null : value;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private void OnTokenInputChanged(ChangeEventArgs args) =>
        TokenInput = args.Value?.ToString() ?? string.Empty;

    private Task VerifyTokenAsync()
    {
        if (ApprovalUiGuard.CanDecide(TokenInput, Tokens.Token))
        {
            Authorized = true;
            TokenHint = null;
            ActionError = null;

            // token 是工作台唯一的门禁钥匙：验证完就从输入框里抹掉
            TokenInput = string.Empty;
        }
        else
        {
            TokenHint = ApprovalUiGuard.InvalidTokenMessage;
        }

        return Task.CompletedTask;
    }

    private async Task DecideAsync(Guid approvalId, bool approve)
    {
        // 连点两次：第二个事件到达时第一个可能还没跑完
        if (Submitting)
        {
            return;
        }

        if (!Authorized)
        {
            ActionError = PageError.Simple(ApprovalUiGuard.MissingTokenMessage);
            return;
        }

        // 这条审批已经裁决过（或者正在裁决）就直接忽略：
        // Blazor 的事件排队处理，已经排进队的第二次点击会在第一次之后才被处理，
        // 那时「正在提交」标志早已复位 —— 只有记住「这条批过了」才挡得住
        var key = approvalId.ToString();
        if (_decisions.IsLatched(key))
        {
            return;
        }

        _decisions.TryLatch(key);
        Submitting = true;

        // 关键：Blazor 在 await 期间不重绘，不主动 StateHasChanged 的话
        // 按钮要等 handler 返回才置灰 —— 这中间用户再点一下就批两次
        StateHasChanged();

        try
        {
            await ApprovalService.DecideAsync(approvalId, approve, "human", string.IsNullOrWhiteSpace(Reason) ? null : Reason);
            Reason = string.Empty;
            ActionError = null;
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            // 失败就把闩锁放掉，好让人改了再试
            _decisions.Release(key);
            ActionError = PageError.From(ex, "裁决审批");
        }
        finally
        {
            Submitting = false;
        }
    }
}
