@page "/Error"
@using System.Diagnostics

<PageTitle>出错 · 开发工作台</PageTitle>

<h1 class="text-danger">出错了</h1>
<h2 class="text-danger">处理你的请求时发生了错误。</h2>

@if (ShowRequestId)
{
    <p>
        <strong>请求 ID：</strong> <code>@RequestId</code>
    </p>
}

<h3>开发模式</h3>
<p>
    切换到 <strong>Development</strong> 环境可以看到这次错误的更多细节。
</p>
<p>
    <strong>已部署的应用不要开启 Development 环境。</strong>
    那会把异常里的敏感信息直接展示给最终用户。
    本地调试时，把环境变量 <strong>ASPNETCORE_ENVIRONMENT</strong> 设为 <strong>Development</strong>
    再重启应用即可。
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}