@* 写操作页面共用的人工凭证门禁。机制与 Approvals.razor 一致：
   服务端渲染阶段看请求本身（Cookie/Header），交互阶段由浏览器去取 token，
   取不到（远程访问）就退回「粘贴控制台里的 token」。
   判定统一走 ApprovalUiGuard.CanDecide，不另写一套。 *@

@using System.Text.Json
@using Microsoft.AspNetCore.Http
@inject HumanTokenAccessor Tokens
@inject IJSRuntime JS

@if (!Authorized)
{
    <div class="wb-panel">
        <p class="wb-error">此页面的写操作需要人工凭证，请先验证身份。</p>
        <p class="wb-muted">
            在本机打开工作台时会自动获取；远程访问请从启动工作台的控制台复制人工 token，粘贴到下面。
        </p>
        <div class="wb-form-row">
            @* 不用 @bind：绑定的值会被 Blazor 写回 DOM 的 value 属性，
               那是把钥匙摊在页面上。这里只在事件里收值。 *@
            <input class="wb-input" type="password" placeholder="人工 token（控制台里那串）"
                   @oninput="OnTokenInputChanged" />
            <button class="wb-btn wb-btn-primary"
                    disabled="@string.IsNullOrWhiteSpace(TokenInput)"
                    @onclick="VerifyTokenAsync">验证</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(TokenHint))
        {
            <p class="wb-hint">@TokenHint</p>
        }
    </div>
}

@code {
    /// <summary>浏览器自己去取 token 的脚本。必须由浏览器发起：
    /// 服务端自己调 /api/human-token 会把「请求来自本机」洗白，远程用户也能拿到 token。</summary>
    private const string FetchTokenScript =
        "fetch('/api/human-token',{credentials:'same-origin'})"
        + ".then(function(r){return r.text().then(function(t){return JSON.stringify({ok:r.ok,status:r.status,body:t});});})"
        + ".catch(function(){return JSON.stringify({ok:false,status:0,body:''});})";

    [Parameter] public bool Authorized { get; set; }
    [Parameter] public EventCallback<bool> AuthorizedChanged { get; set; }

    private string TokenInput { get; set; } = string.Empty;
    private string? TokenHint { get; set; }

    /// <summary>服务端渲染阶段能看到请求本身；交互阶段拿不到（电路里没有 HttpContext）。</summary>
    [CascadingParameter] public HttpContext? RequestContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!Authorized && ApprovalUiGuard.CanDecide(RequestContext?.Request, Tokens.Token))
        {
            await SetAuthorizedAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 预渲染阶段没有 JS 运行时，自动取 token 只能放在交互阶段
        if (!firstRender || Authorized)
        {
            return;
        }

        string? payload = null;

        try
        {
            payload = await JS.InvokeAsync<string>("eval", FetchTokenScript);
        }
        catch (JSException)
        {
            // 取不到就走粘贴流程，不影响页面其它功能
        }
        catch (InvalidOperationException)
        {
            // 预渲染阶段没有 JS 运行时
        }

        var token = ExtractToken(payload);

        if (token is not null && ApprovalUiGuard.CanDecide(token, Tokens.Token))
        {
            await SetAuthorizedAsync();
            TokenHint = null;
        }
        else
        {
            TokenHint = "没能自动取到人工凭证（远程访问时这是正常的）。请从启动工作台的控制台复制 token 粘贴到上面。";
        }

        StateHasChanged();
    }

    private async Task SetAuthorizedAsync()
    {
        Authorized = true;
        await AuthorizedChanged.InvokeAsync(true);
    }

    /// <summary>从浏览器拿回来的 JSON 里抠出 token。取不到就当没有。</summary>
    private static string? ExtractToken(string? payload)
    {
        if (string.IsNullOrWhiteSpace(payload))
        {
            return null;
        }

        try
        {
            using var outer = JsonDocument.Parse(payload);

            if (!outer.RootElement.TryGetProperty("ok", out var ok) || !ok.GetBoolean())
            {
                return null;
            }

            if (!outer.RootElement.TryGetProperty("body", out var body))
            {
                return null;
            }

            using var inner = JsonDocument.Parse(body.GetString() ?? "{}");

            if (!inner.RootElement.TryGetProperty("token", out var token))
            {
                return null;
            }

            var value = token.GetString();
            return string.IsNullOrWhiteSpace(value) ? null : value;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private void OnTokenInputChanged(ChangeEventArgs args) =>
        TokenInput = args.Value?.ToString() ?? string.Empty;

    private async Task VerifyTokenAsync()
    {
        if (ApprovalUiGuard.CanDecide(TokenInput, Tokens.Token))
        {
            await SetAuthorizedAsync();
            TokenHint = null;

            // token 是工作台唯一的门禁钥匙：验证完就从输入框里抹掉
            TokenInput = string.Empty;
        }
        else
        {
            TokenHint = ApprovalUiGuard.InvalidTokenMessage;
        }
    }
}