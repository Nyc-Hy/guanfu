<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Workbench.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="$(SqlClientVersion)" />
    <!-- T-SQL 解析器：把 SQL 解析成 AST，按语句类型判定读写，
         而不是靠「首关键字 + 手搓分词器」猜。 -->
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="$(ScriptDomVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Workbench.Domain\Workbench.Domain.csproj" />
    <ProjectReference Include="..\Workbench.Application\Workbench.Application.csproj" />
    <ProjectReference Include="..\Workbench.Documents\Workbench.Documents.csproj" />
  </ItemGroup>

</Project>
